<Window x:Class="CaloriesCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CaloriesCalculator"
        xmlns:cmc="clr-namespace:CaloriesCalculator.Controls"
        mc:Ignorable="d"
        Title="Калькулятор калорій"
        Loaded="Window_Loaded"
        d:DesignHeight="1080" d:DesignWidth="1920"
        MinHeight="500" MinWidth="800"
        Height="500" Width="800">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg1Color">#F0EADA</SolidColorBrush>
        <SolidColorBrush x:Key="Bg2Color">#FFF6E5</SolidColorBrush>
        <SolidColorBrush x:Key="TextColor">#001858</SolidColorBrush>
        <SolidColorBrush x:Key="BtnBgColor">#F582AE</SolidColorBrush>
        
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>
        
        <ContextMenu x:Key="HeaderPopUp">
            <MenuItem Header="Налаштувати" Click="SetupProfilePopUp_Click"/>
            <Separator/>
            <MenuItem Header="Вийти" Click="LogoutPopUp_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid Background="{StaticResource Bg1Color}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation Menu -->
        <Grid RowSpan="2" MaxWidth="315">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style TargetType="{x:Type cmc:NavMenuItemControl}">
                    <Setter Property="Margin" Value="0 8 0 0"/>
                </Style>
            </Grid.Resources>

            <Image Margin="5" Height="32" Source="/Assets/Logo.png"/>
            <StackPanel Grid.Row="1" Margin="0 25 0 0">
                <cmc:NavMenuItemControl Icon="Profile" Text="Профіль" Tag="Profile" x:Name="ProfileMenuItem" Click="NavMenuItemControl_Click"/>
                <cmc:NavMenuItemControl Icon="Food" Text="Продукти" Tag="Products" Click="NavMenuItemControl_Click"/>
            </StackPanel>
            <cmc:NavMenuItemControl Grid.Row="2" Icon="Gear" Text="Опції" Tag="Settings" Click="NavMenuItemControl_Click"/>
        </Grid>

        <!-- Profile Header -->
        <Grid Grid.Row="0" Grid.Column="1" ColumnSpan="2" Height="42" Background="{StaticResource Bg2Color}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="PageTitleTextBlock" FontSize="20" Margin="10 0" VerticalAlignment="Center"/>
            <Grid Grid.Column="2" Margin="10 0" VerticalAlignment="Center" x:Name="CurrentProfileGrid" Visibility="Visible">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Height="32" Width="32">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="CurrentProfileImageBrush" ImageSource="{x:Null}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Button Background="{x:Null}" BorderBrush="{x:Null}" Foreground="{x:Null}" Click="ProfileHeaderButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CurrentProfileNameTextBlock" FontSize="20" Margin="5 0 0 0" VerticalAlignment="Center"/>
                            <Polygon Margin="15 0 0 0" Points="0,0 8,0 4,8" VerticalAlignment="Center" Fill="{StaticResource TextColor}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Calories Meter -->
        <Grid Grid.Row="1" Grid.Column="2" Margin="20 10" x:Name="CaliriesMeterGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0" Orientation="Vertical">
                <DatePicker BorderBrush="{StaticResource BtnBgColor}" Background="{StaticResource BtnBgColor}" Foreground="{StaticResource TextColor}"
                            HorizontalAlignment="Center" FontSize="14" FirstDayOfWeek="Monday" SelectedDateFormat="Long"
                            x:Name="CaloriesDatePicker" SelectedDateChanged="CaloriesDate_Changed"/>
                <cmc:CaloriesProgressBarControl Margin="0 25" x:Name="CaloriesProgress"/>
            </StackPanel>
            <cmc:NutritionsMeterControl Grid.Row="1" VerticalAlignment="Center" x:Name="NutritionsMeter"/>
        </Grid>

        <!-- Menu Pages -->
        <Frame Grid.Row="1" Grid.Column="1" Name="ContentFrame" Background="{StaticResource Bg2Color}" IsTabStop="True"
               Navigated="ContentFrame_Navigated" NavigationUIVisibility="Hidden"/>

    </Grid>
</Window>
