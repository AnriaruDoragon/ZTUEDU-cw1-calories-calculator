<Page x:Class="CaloriesCalculator.Pages.ConsumptionHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CaloriesCalculator.Pages"
      xmlns:cmc="clr-namespace:CaloriesCalculator.Controls"
      mc:Ignorable="d" 
      d:DesignWidth="380"
      Title="Історія споживання продуктів"
      Loaded="Page_Loaded">
    
    <Page.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>
        <Style TargetType="{x:Type ListView}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="20" Text="Для початку увійдіть в ваш профіль!"
                   x:Name="NoProfileTextBlock" Visibility="Collapsed"/>
        
        <ScrollViewer Grid.Row="0" Grid.Column="0" Padding="0 0 5 0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      x:Name="ConsumptionViewer" Visibility="Visible">
            <ListView x:Name="ConsumeHistoryListView" HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <cmc:ConsumedProductListViewItem Product="{Binding}" Deleted="ConsumedProduct_Deleted"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
    </Grid>
</Page>
