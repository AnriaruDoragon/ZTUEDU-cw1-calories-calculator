<Window x:Class="CaloriesCalculator.Pages.Dialogs.EditProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CaloriesCalculator.Pages.Dialogs"
        mc:Ignorable="d"
        x:Name="EditDialog"
        Title="Редагування продукту"
        MinWidth="350" MaxWidth="500"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        Background="{StaticResource Bg1Color}"
        Loaded="EditDialog_Loaded">
    
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource BtnBgColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="BorderBrush" Value="{StaticResource FieldBgColor}"/>
            <Setter Property="Background" Value="{StaticResource FieldBgColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource FieldBgColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 2.5 5 2.5"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" x:Name="NutritionsRow"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Назва:"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Опис:"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Калорійність:"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Розмір порції:"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Тип:"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Цінність (г):" VerticalAlignment="Top"/>
            
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding Path=Product.Name, ElementName=EditDialog, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Grid.Row="1" Grid.Column="1" AcceptsReturn="True"
                     Text="{Binding Path=Product.Description, ElementName=EditDialog, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBox MaxWidth="50" BorderBrush="Red" BorderThickness="0"
                         x:Name="CaloriesTextBox" TextChanged="CaloriesTextBox_TextChanged"/>
                <TextBlock Text="ккал на"/>
                <TextBox MaxWidth="50" BorderBrush="Red" BorderThickness="0"
                         x:Name="ServingSizeTextBox" TextChanged="ServingSizeTextBox_TextChanged"/>
                <TextBlock Text="г продукту"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                <TextBox MaxWidth="50" BorderBrush="Red" BorderThickness="0"
                         x:Name="NetMassTextBox" TextChanged="NetMassTextBox_TextChanged"/>
                <TextBlock Text="г"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                <ComboBox Width="120" VerticalAlignment="Center"
                          x:Name="TypeComboBox" SelectionChanged="TypeComboBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Value}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox VerticalAlignment="Center" Content="Газована" Margin="5 0 0 0"
                          x:Name="CarbonatedCheckBox"/>
            </StackPanel>
            <Grid Grid.Row="5" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Жири:"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Білки:"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Вуглеводи:"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Волокна:"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Сіль: "/>
                    
                <TextBox Grid.Row="0" Grid.Column="1" Width="100" HorizontalAlignment="Left" BorderBrush="Red" BorderThickness="0"
                         x:Name="FatTextBox" TextChanged="NutritionTextBox_TextChanged"/>
                <TextBox Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left" BorderBrush="Red" BorderThickness="0"
                         x:Name="ProteintTextBox" TextChanged="NutritionTextBox_TextChanged"/>
                <TextBox Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left" BorderBrush="Red" BorderThickness="0"
                         x:Name="CarbsTextBox" TextChanged="NutritionTextBox_TextChanged"/>
                <TextBox Grid.Row="3" Grid.Column="1" Width="100" HorizontalAlignment="Left" BorderBrush="Red" BorderThickness="0"
                         x:Name="FiberTextBox" TextChanged="NutritionTextBox_TextChanged"/>
                <TextBox Grid.Row="4" Grid.Column="1" Width="100" HorizontalAlignment="Left" BorderBrush="Red" BorderThickness="0"
                         x:Name="SodiumTextBox" TextChanged="NutritionTextBox_TextChanged"/>
            </Grid>
        </Grid>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0 10 0 0">
            <Button Padding="5" x:Name="ConfirmButton" IsDefault="True" Click="ConfirmButton_Click" Content="Зберегти зміни"/>
            <Button Margin="10 0 0 0" Padding="5" x:Name="CancelButton" IsCancel="True" Click="CancelButton_Click" Content="Скасувати"/>
        </StackPanel>
    </Grid>
</Window>
