<Page x:Class="CaloriesCalculator.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CaloriesCalculator.Pages"
      mc:Ignorable="d" 
      d:DesignWidth="380"
      MaxWidth="400"
      Title="Профіль користувача"
      Loaded="Page_Loaded">

    <ScrollViewer Padding="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#001858"/>
            </Style>
            <Style TargetType="{x:Type Button}">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="#FFF582AE"/>
                <Setter Property="Foreground" Value="#001858"/>
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="#FF8BD3DD"/>
                <Setter Property="Foreground" Value="#001858"/>
            </Style>
            <Style TargetType="{x:Type PasswordBox}">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="#FF8BD3DD"/>
                <Setter Property="Foreground" Value="#001858"/>
            </Style>
            <Style TargetType="{x:Type RadioButton}">
                <Setter Property="Foreground" Value="#001858"/>
                <Setter Property="Margin" Value="0 0 10 0"/>
            </Style>
        </Grid.Resources>
        
        <!-- Login elements -->
        <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"
              x:Name="LoginGrid">
            <StackPanel>
                <TextBlock Text="Логін:" HorizontalAlignment="Center"/>
                <TextBox Width="150" Margin="0 0 0 10" FontSize="18" MaxLength="128" x:Name="LoginTextBox"/>
                <TextBlock Text="Пароль:" HorizontalAlignment="Center"/>
                <PasswordBox Width="150" Margin="0 0 0 10" FontSize="18" MaxLength="128" x:Name="LoginPasswordBox"/>
                <Button x:Name="LoginButton" FontSize="18" Content="Увійти"
                        Click="LoginButton_Click"/>
                <Button Margin="0 10" x:Name="RegisterButton" FontSize="18" Content="Зареєструватися"
                        Click="RegisterButton_Click"/>
                <Button x:Name="ResetPasswordButton" Content="Забув пароль" Background="{x:Null}" HorizontalAlignment="Center"
                        Click="ResetPasswordButton_Click"/>
            </StackPanel>
        </Grid>
        
        <!-- Manage profile elements -->
        <Grid Grid.Row="0" Grid.Column="0" Visibility="Visible" x:Name="ManageGrid">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Налаштування профілю" Margin="0 0 0 5" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" Text="ID: " TextAlignment="Right" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" Text="Логін: " TextAlignment="Right" FontWeight="Bold"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="5" Text="Ім'я: " TextAlignment="Right" FontWeight="Bold"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="5" Text="Аватар: " TextAlignment="Right" FontWeight="Bold"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="5" x:Name="ManageProfileIDTextBlock"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="5" x:Name="ManageProfileLoginTextBlock"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="5">
                        <TextBox MaxWidth="200" Height="20" HorizontalAlignment="Left" MaxLength="64"
                                 x:Name="ManageProfileNameTextBox" TextChanged="ManageProfileNameTextBox_TextChanged"/>
                        <Button Margin="5 0 0 0" Content="Зберегти" x:Name="ManageProfileNameSaveButton" Click="ManageProfileNameSaveButton_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="5">
                        <Ellipse Height="20" Width="20" StrokeThickness="1" Stroke="Black">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="ManageProfileImageBrush" ImageSource="{x:Null}"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Button Margin="5 0 0 0" Content="Обрати файл" Click="SelectAvatarButton_Click"/>
                        <Button Margin="5 0 0 0" Content="Видалити аватар"
                                x:Name="DeleteAvatarButton" Click="DeleteAvatarButton_Click"/>
                    </StackPanel>
                    <Grid Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="5" Text="Зміна паролю:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" Text="Поточний пароль: " TextAlignment="Right"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="5" Text="Новий пароль: " TextAlignment="Right"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="5" Text="Повторіть пароль: " TextAlignment="Right"/>
                        
                        <PasswordBox Grid.Row="1" Grid.Column="1" Margin="5" Width="150"
                                     MaxLength="128" x:Name="ManageOldPasswordBox"/>
                        <PasswordBox Grid.Row="2" Grid.Column="1" Margin="5" Width="150"
                                     MaxLength="128" x:Name="ManageNewPasswordBox"/>
                        <PasswordBox Grid.Row="3" Grid.Column="1" Margin="5" Width="150"
                                     MaxLength="128" x:Name="ManageRepPasswordBox"/>
                        <Button Grid.Row="4" Grid.Column="1" Content="Змінити пароль" Margin="5"
                                Click="ChangePasswordButton_Click"/>
                    </Grid>
                </Grid>
                
                <TextBlock Text="Розрахунок щоденної мети" Margin="0 15 0 5" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="Для автоматичного розрахунку мети, будь ласка, заповніть усі поля нижче, та натисніть відповідну кнопку." TextWrapping="Wrap" Margin="5"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" Text="Стать: " TextAlignment="Right" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" Text="Мета: " TextAlignment="Right" FontWeight="Bold"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="5" Text="Дата народження: " TextAlignment="Right" FontWeight="Bold"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="5" Text="Зріст (в см): " TextAlignment="Right" FontWeight="Bold"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="5" Text="Вага (в кг): " TextAlignment="Right" FontWeight="Bold"/>
                    
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="5">
                        <RadioButton GroupName="ProfileSex" Checked="ProfilePreferences_Updated" x:Name="ProfileMaleSexRB" Content="Чоловік"/>
                        <RadioButton GroupName="ProfileSex" Checked="ProfilePreferences_Updated" x:Name="ProfileFemaleSexRB" Content="Жінка"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="5">
                        <RadioButton GroupName="ProfileGoal" Checked="ProfilePreferences_Updated" x:Name="ProfileLoseGoalRB" Content="Схуднути"/>
                        <RadioButton GroupName="ProfileGoal" Checked="ProfilePreferences_Updated" x:Name="ProfileMaintaintGoalRB" Content="Утримати"/>
                        <RadioButton GroupName="ProfileGoal" Checked="ProfilePreferences_Updated" x:Name="ProfileGainGoalRB" Content="Набрати"/>
                    </StackPanel>
                    <DatePicker Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"
                                SelectedDateFormat="Long" Width="250" BorderThickness="0"
                                x:Name="ProfileBirthdatDatePicker" SelectedDateChanged="ProfilePreferences_Updated"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="5" Width="250" HorizontalAlignment="Left"
                             x:Name="ProfileHeightTextBox" TextChanged="ProfilePreferences_Updated"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="5" Width="250" HorizontalAlignment="Left"
                             x:Name="ProfileWeightTextBox" TextChanged="ProfilePreferences_Updated"/>
                    <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="5" MaxWidth="360">
                        <Button Content="Розрахувати мету автоматично" HorizontalAlignment="Left" FontWeight="Bold" Padding="5"
                                x:Name="CalculateGoalButton" Click="CalculateGoalButton_Click" Visibility="Collapsed"/>
                        <Button Content="Встановити власну мету"  HorizontalAlignment="Right" FontWeight="Bold" Padding="5"
                                Click="SetOwnGoalButton_Click"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>
