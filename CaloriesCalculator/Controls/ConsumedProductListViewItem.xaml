<UserControl x:Class="CaloriesCalculator.Controls.ConsumedProductListViewItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CaloriesCalculator.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="500"
             Padding="5 5 5 4"
             BorderBrush="{StaticResource TextColor}" BorderThickness="0 0 0 1"
             Loaded="UserControl_Loaded">
    
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource BtnBgColor}"/>
        </Style>
        <Style TargetType="{x:Type Path}">
            <Setter Property="Stroke" Value="{StaticResource TextColor}"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <Image Grid.Column="0" Height="32" Width="32" Margin="0 0 10 0" x:Name="IconImage"/>
        <TextBlock Grid.Column="1" FontWeight="Bold" Margin="0 0 10 0" x:Name="NameTextBlock" Text="Product"/>
        
        <TextBlock Grid.Column="3" Margin="0 0 10 0" x:Name="MassTextBlock" Text="Mass"/>
        <Button Grid.Column="4" Height="32" Width="32" Click="DeleteButton_Click">
            <Path Data="M0,0L16,16M16,0L0,16" Width="16" Height="16"/>
        </Button>
        
    </Grid>
</UserControl>
